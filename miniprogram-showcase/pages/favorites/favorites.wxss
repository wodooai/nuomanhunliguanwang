.page{padding:35rpx 28rpx 140rpx;background:#fafafa;min-height:100vh}.title{font-size:42rpx;font-weight:bold;margin-bottom:28rpx}.empty{text-align:center;background:#fff;padding:90rpx 20rpx;color:#aaa;line-height:2}.empty text{color:#637493}.card{display:flex;gap:22rpx;background:#fff;border-radius:14rpx;padding:16rpx;margin-bottom:18rpx;font-size:30rpx;font-weight:bold}.card image{width:190rpx;height:135rpx;border-radius:8rpx}.card text{display:block;font-size:23rpx;color:#999;margin-top:14rpx}.tabbar{position:fixed;bottom:0;left:0;right:0;height:108rpx;background:#fff;border-top:1rpx solid #eee;display:flex;justify-content:space-around;align-items:center}.tabbar view{text-align:center;font-size:34rpx;color:#999}.tabbar text{display:block;font-size:21rpx;margin-top:4rpx}.tabbar .active{color:#f49382}
