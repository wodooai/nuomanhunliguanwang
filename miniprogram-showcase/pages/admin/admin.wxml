<view class="page" wx:if="{{!authorized}}"><view class="title">管理员登录</view><input placeholder="管理员账号" data-key="account" bindinput="input"/><input placeholder="管理员密码" password data-key="password" bindinput="input"/><button bindtap="login">登录</button></view><view class="page" wx:else><button class="case-button" bindtap="cases">案例管理（新增、修改、上传图片）</button><view class="title">店长申请</view><view class="empty" wx:if="{{!applications.length}}">暂无待审核申请</view><view class="card" wx:for="{{applications}}" wx:key="id"><view class="name">{{item.displayName||item.name}} · {{item.position}}</view><view>真实姓名：{{item.name}}</view><view>登录账号/联系方式：{{item.account}}</view><view>身份证：{{item.idNumber}}</view><input placeholder="审核备注（可选）" data-id="{{item.id}}" bindinput="reviewRemark"/><view class="actions"><button data-id="{{item.id}}" data-decision="approved" bindtap="review">同意</button><button class="reject" data-id="{{item.id}}" data-decision="rejected" bindtap="review">拒绝</button></view></view><view class="title second">已审核店长</view><view class="card" wx:for="{{managers}}" wx:key="id"><view class="name">{{item.displayName||item.name}} · {{item.position}}</view><view>真实姓名：{{item.name}}</view><view>登录账号/联系方式：{{item.account}}</view><view>身份证：{{item.idNumber}}</view><textarea placeholder="管理员备注（不修改个人信息）" value="{{item.remark}}" data-id="{{item.id}}" bindinput="managerRemark"/><button class="note" data-id="{{item.id}}" bindtap="saveRemark">保存备注</button></view></view>
