.page{padding:32rpx;background:#fafafa;min-height:100vh}.title{font-size:39rpx;font-weight:bold;margin:20rpx 0 28rpx}.second{margin-top:55rpx}.page>input{background:#fff;padding:30rpx 18rpx;border-bottom:1rpx solid #eee}.page>button{margin-top:40rpx;background:#f49382;color:#fff;border-radius:44rpx}.case-button{margin:0 0 35rpx!important;background:#637493!important}.card{margin:18rpx 0;background:#fff;border-radius:14rpx;padding:24rpx;color:#555;font-size:26rpx;line-height:1.9}.name{font-size:31rpx;color:#222;font-weight:bold}.card input,.card textarea{display:block;box-sizing:border-box;width:100%;background:#fafafa;padding:14rpx;margin-top:14rpx;font-size:25rpx}.actions{display:flex;gap:15rpx}.actions button,.note{font-size:25rpx;margin-top:15rpx;background:#e79787;color:white}.actions .reject{background:#aaa}.note{width:200rpx;margin-left:0}.empty{color:#999;padding:30rpx;background:#fff;border-radius:12rpx}
