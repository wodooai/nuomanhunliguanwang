.hero{height:500rpx;margin:0 -20rpx;position:relative;overflow:hidden}.hero image{width:100%;height:100%}.hero-shade,.dark{position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.46),rgba(0,0,0,.03) 70%)}.hero-copy{position:absolute;bottom:48rpx;left:44rpx;color:#fff;font-family:serif;text-shadow:0 2rpx 8rpx #0008}.hero-copy text{font-size:42rpx;letter-spacing:4rpx}.hero-copy view{font-size:27rpx;margin:8rpx 0}.hero-copy small{font-size:19rpx;opacity:.9}.quick{height:155rpx;display:flex;align-items:center;justify-content:space-around;border-bottom:10rpx solid #fafafa}.quick view{text-align:center;color:#ababab;font-size:22rpx}.quick text:first-child{display:block;font-size:31rpx;margin-bottom:12rpx}.section{padding-top:48rpx}.feature-scroll{white-space:nowrap;margin:20rpx -20rpx 0;padding-left:20rpx}.feature-card{display:inline-block;position:relative;width:610rpx;height:350rpx;border-radius:7rpx;overflow:hidden;margin-right:16rpx;color:#fff;vertical-align:top}.feature-card image,.genre image{width:100%;height:100%}.feature-title{position:absolute;left:25rpx;bottom:54rpx;right:20rpx;white-space:normal;font-size:46rpx;line-height:1.12;font-weight:800;text-shadow:0 3rpx 5rpx #0008}.feature-foot{position:absolute;bottom:20rpx;left:25rpx;right:25rpx;font-size:21rpx;display:flex;justify-content:space-between}.genre-grid{display:grid;grid-template-columns:1fr 1fr;gap:8rpx;margin-top:20rpx}.genre{height:220rpx;position:relative;overflow:hidden;color:#fff}.genre text{position:absolute;left:0;right:0;top:78rpx;text-align:center;font-size:30rpx;font-weight:700;text-shadow:0 2rpx 6rpx #000}.genre small{position:absolute;left:0;right:0;top:122rpx;text-align:center;font-size:20rpx}.all{text-align:center;color:#637493;font-size:25rpx;padding:34rpx}.brand-end{text-align:center;color:#f49382;font-size:28rpx;padding:20rpx 0 160rpx}.brand-end small{font-size:20rpx;color:#ccc}.tabbar{position:fixed;bottom:0;left:0;right:0;height:108rpx;background:#fff;border-top:1rpx solid #eee;display:flex;justify-content:space-around;align-items:center;z-index:8}.tabbar view{text-align:center;font-size:34rpx;color:#999}.tabbar text{display:block;font-size:21rpx;margin-top:4rpx}.tabbar .active{color:#f49382}
