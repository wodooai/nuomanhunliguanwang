.hero{height:530rpx;position:relative;color:#fff}.hero image{width:100%;height:100%}.shade{position:absolute;inset:0;background:#0005}.back{position:absolute;top:80rpx;left:22rpx;font-size:70rpx;font-weight:200}.capsule{position:absolute;top:82rpx;right:22rpx;border:1rpx solid #fff8;border-radius:30rpx;padding:9rpx 17rpx;letter-spacing:4rpx}.hero-title{position:absolute;left:0;right:0;top:265rpx;text-align:center;font-size:42rpx;font-weight:700}.hero-title small{display:block;font-size:23rpx;margin-top:12rpx}.count{padding:28rpx 22rpx;font-size:26rpx;border-bottom:1rpx solid #eee}.count text{float:right;font-size:35rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;padding:14rpx 12rpx 145rpx}.card image{height:220rpx;width:100%;border-radius:5rpx}.name{font-size:26rpx;white-space:nowrap;text-overflow:ellipsis;overflow:hidden;padding-top:8rpx}.meta{font-size:21rpx;color:#aaa;padding:6rpx 0 14rpx}.tabbar{position:fixed;bottom:0;left:0;right:0;height:108rpx;background:#fff;border-top:1rpx solid #eee;display:flex;justify-content:space-around;align-items:center;z-index:5}.tabbar view{text-align:center;font-size:34rpx;color:#999}.tabbar text{display:block;font-size:21rpx;margin-top:4rpx}
