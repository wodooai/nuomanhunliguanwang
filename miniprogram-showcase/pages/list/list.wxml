<view><view class="hero" wx:if="{{cover}}"><image src="{{cover}}" mode="aspectFill"/><view class="shade"/><view class="back" bindtap="back">‹</view><view class="capsule">•••　○</view><view class="hero-title">{{title}}<small>查看所有作品</small></view></view><view class="count">共{{list.length}}套作品　　<text>▦</text></view><view class="grid"><view class="card" wx:for="{{list}}" wx:key="id" bindtap="detail" data-id="{{item.id}}"><image src="{{item.cover}}" mode="aspectFill"/><view class="name">{{item.title}}</view><view class="meta">{{item.category}}　♡</view></view></view><view class="tabbar"><view bindtap="home">⌂<text>首页</text></view><view bindtap="favorites">♡<text>收藏</text></view><view bindtap="profile">◉<text>我的</text></view></view></view>
