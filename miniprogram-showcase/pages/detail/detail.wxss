.mini-nav{height:96rpx;padding:48rpx 20rpx 0;display:flex;align-items:center;justify-content:space-between;background:#fff}.brand{display:flex;align-items:center;gap:14rpx;font-weight:700;color:#627592}.brand-mark{width:46rpx;height:46rpx;line-height:46rpx;border-radius:50%;text-align:center;background:#fff;border:1rpx solid #eee;font-family:serif;color:#333;font-size:20rpx}.back{font-size:60rpx;color:#111;font-weight:200}.capsule{border:1rpx solid #eee;border-radius:30rpx;padding:9rpx 18rpx;font-size:25rpx;letter-spacing:4rpx}.cover{width:100%;display:block}.body{padding:0 8rpx 220rpx}.title-row{display:flex;justify-content:space-between;align-items:center;padding-top:22rpx}.title{font-size:36rpx}.heart{font-size:38rpx;color:#8fa0b7}.date{text-align:right;color:#c4cad2;font-size:23rpx;padding:12rpx 0 55rpx}.detail-label{font-size:28rpx;padding-bottom:16rpx}.photo{width:100%;display:block;margin-bottom:20rpx;border-radius:4rpx}.recommend{text-align:center;color:#ddd;font-size:22rpx;padding:45rpx 0}.bottom{height:185rpx;background:#fff;border-top:1rpx solid #ddd;position:fixed;bottom:0;left:0;right:0;color:#637493;z-index:5}.share{text-align:center;height:76rpx;line-height:76rpx;font-size:27rpx;border-bottom:1rpx solid #eee}.tabs{display:flex;justify-content:space-around;align-items:center;height:108rpx}.tabs view{text-align:center;font-size:34rpx;color:#999}.tabs text{display:block;font-size:21rpx;margin-top:4rpx}
