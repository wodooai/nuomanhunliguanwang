<view wx:if="{{item}}"><view class="mini-nav" style="padding-top:{{navTop}}px"><view class="brand" bindtap="back"><text class="back">‹</text><view class="brand-mark">NM</view><text>诺漫婚礼</text></view><view class="capsule">•••　○</view></view><image class="cover" src="{{item.cover}}" mode="widthFix" data-url="{{item.cover}}" bindtap="preview"/><view class="body"><view class="title-row"><text class="title">{{item.title}}</text><text class="heart" bindtap="like">{{liked?'♥':'♡'}} {{item.likes}}</text></view><view class="date">{{item.date}}</view><view class="detail-label">详情展示</view><image class="photo" wx:for="{{images}}" wx:key="*this" src="{{item}}" mode="widthFix" data-url="{{item}}" bindtap="preview"/><view class="recommend" wx:if="{{images.length}}"><text>诺漫婚礼案例展示</text></view></view><view class="bottom"><view class="share" bindtap="share">⇱　分享案例</view><view class="tabs"><view bindtap="home">⌂<text>首页</text></view><view bindtap="favorites">♡<text>收藏</text></view><view bindtap="profile">◉<text>我的</text></view></view></view></view>
