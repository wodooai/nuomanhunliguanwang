.page{padding:45rpx 30rpx 150rpx;background:#fafafa;min-height:100vh}.profile{display:flex;align-items:center;gap:22rpx;margin:15rpx 0 38rpx}.avatar{width:100rpx;height:100rpx;border-radius:50%;background:#f49382;color:#fff;text-align:center;line-height:100rpx;font-size:42rpx}.name{font-size:37rpx;font-weight:bold}.role{font-size:24rpx;color:#999;margin-top:10rpx}.card{background:#fff;border-radius:15rpx;padding:8rpx 24rpx}.card view{padding:23rpx 0;border-bottom:1rpx solid #f1f1f1;font-size:27rpx}.card view:last-child{border:0}.card text{display:inline-block;width:155rpx;color:#999}.admin{margin-top:35rpx}.section-title{font-size:31rpx;font-weight:bold;margin-bottom:15rpx}.admin button{margin:14rpx 0;background:#637493;color:#fff;border-radius:14rpx;font-size:27rpx}.logout{margin-top:45rpx;background:#fff;color:#c66;border:1rpx solid #ecc}.tabbar{position:fixed;bottom:0;left:0;right:0;height:108rpx;background:#fff;border-top:1rpx solid #eee;display:flex;justify-content:space-around;align-items:center}.tabbar view{text-align:center;font-size:34rpx;color:#999}.tabbar text{display:block;font-size:21rpx;margin-top:4rpx}.tabbar .active{color:#f49382}
