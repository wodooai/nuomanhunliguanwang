<view class="page"><view class="profile"><view class="avatar">{{manager.displayName?manager.displayName.slice(0,1):'我'}}</view><view><view class="name">{{manager.displayName||manager.name||'用户'}}</view><view class="role">{{role==='admin'?'管理员':manager.position||'店长'}}</view></view></view><view class="card"><view><text>真实姓名</text>{{manager.name||'管理员'}}</view><view><text>登录账号</text>{{manager.account}}</view><view wx:if="{{manager.position}}"><text>职位</text>{{manager.position}}</view></view><view wx:if="{{role==='admin'}}" class="admin"><view class="section-title">管理员功能</view><button bindtap="applications">审批店长申请</button><button bindtap="cases">案例管理：上传、新增、修改</button></view><button class="logout" bindtap="logout">退出登录</button><view class="tabbar"><view bindtap="home">⌂<text>首页</text></view><view bindtap="favorites">♡<text>收藏</text></view><view class="active">◉<text>我的</text></view></view></view>
