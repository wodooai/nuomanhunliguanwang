.page{padding:30rpx}.title{font-size:42rpx;font-weight:bold;margin-bottom:25rpx}.page input,.input,.page textarea{display:block;box-sizing:border-box;width:100%;border-bottom:1rpx solid #eee;padding:28rpx 8rpx;font-size:28rpx}.page textarea{height:160rpx}.label{font-size:27rpx;margin-top:28rpx}.tags{margin-top:15rpx}.tag{display:inline-block;padding:10rpx 18rpx;border:1rpx solid #ddd;border-radius:99rpx;margin:0 12rpx 12rpx 0;font-size:23rpx}.tag.active{background:#637493;border-color:#637493;color:#fff}.photos{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:16rpx}.photo{position:relative}.photo image,.upload{width:205rpx;height:205rpx;border-radius:9rpx}.upload{margin:0;background:#fff;border:1rpx dashed #999;color:#637493;font-size:24rpx}.cover,.remove{position:absolute;padding:4rpx 10rpx;color:#fff;font-size:20rpx}.cover{left:0;bottom:0;background:#637493}.remove{right:0;top:0;background:#c66}.save{margin:50rpx 0 25rpx;background:#f49382;color:#fff;border-radius:44rpx}
