.page{min-height:100vh;padding:150rpx 50rpx;background:linear-gradient(160deg,#fff7f4,#fff)}.logo{margin:auto;width:100rpx;height:100rpx;border-radius:50%;background:#f49382;color:white;text-align:center;line-height:100rpx;font-weight:bold;font-size:36rpx}.title{text-align:center;font-size:46rpx;font-weight:bold;margin-top:35rpx}.sub{text-align:center;color:#999;margin:16rpx 0 70rpx}.card{background:#fff;padding:35rpx;border-radius:20rpx;box-shadow:0 12rpx 35rpx #eecfc955}.card input{border-bottom:1rpx solid #eee;padding:28rpx 5rpx}.remember{display:block;color:#777;font-size:26rpx;margin:28rpx 0}.card button{background:#f49382;color:white;border-radius:44rpx}.links{display:flex;justify-content:space-between;color:#b67568;font-size:25rpx;margin-top:34rpx}
