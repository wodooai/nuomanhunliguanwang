page{background:#fff;color:#171717;font-family:Arial,"PingFang SC",sans-serif}.page{padding:0 20rpx 40rpx}.muted{color:#a7a7a7;font-size:24rpx}.empty{text-align:center;padding:120rpx 0;color:#999}.section-title{text-align:center;font-weight:700;font-size:32rpx;line-height:1.25}.section-sub{text-align:center;font-size:22rpx;color:#555;margin-top:4rpx}.mini-nav{height:96rpx;padding-top:48rpx;display:flex;align-items:center;justify-content:space-between;background:#fff}.brand{display:flex;align-items:center;gap:14rpx;font-weight:700;color:#627592}.brand-mark{width:46rpx;height:46rpx;line-height:46rpx;border-radius:50%;text-align:center;background:#fff;border:1rpx solid #eee;font-family:serif;color:#333;font-size:20rpx}.capsule{border:1rpx solid #eee;border-radius:30rpx;padding:9rpx 18rpx;font-size:25rpx;letter-spacing:4rpx;color:#222}
