<view class="page"><view class="title">{{id?'编辑案例':'新增案例'}}</view><input class="input" placeholder="案例名称 *" value="{{form.title}}" data-key="title" bindinput="field"/><picker range="{{db.categories}}" value="0" bindchange="field" data-key="category"><view class="input">{{form.category||'选择分类'}}</view></picker><input class="input" type="text" placeholder="婚礼日期，例如 2026-09-03" value="{{form.date}}" data-key="date" bindinput="field"/><textarea class="input textarea" placeholder="案例介绍" value="{{form.description}}" data-key="description" bindinput="field"/><view class="label">标签</view><view class="tags"><text wx:for="{{db.tags}}" wx:key="*this" class="tag {{form.tags.includes(item)?'active':''}}" data-value="{{item}}" bindtap="tag">{{item}}</text></view><view class="label">案例图片（点击图片设为封面）</view><view class="photos"><view class="photo" wx:for="{{form.images}}" wx:key="*this"><image mode="aspectFill" src="{{item}}" data-url="{{item}}" bindtap="cover"/><text wx:if="{{form.cover===item}}" class="cover">封面</text><text class="remove" data-index="{{index}}" bindtap="remove">×</text></view><button class="add" loading="{{busy}}" bindtap="choose">＋ 上传图片</button></view><button class="button save" loading="{{busy}}" bindtap="save">保存案例</button></view>
