.title{font-family:serif;font-size:48rpx;margin-bottom:25rpx}.textarea{height:150rpx;width:auto}.label{margin-top:25rpx;font-size:27rpx}.tags{margin-top:15rpx}.tag{display:inline-block;border:1rpx solid #dfd2c5;border-radius:99rpx;padding:11rpx 20rpx;margin:0 12rpx 12rpx 0;font-size:23rpx}.tag.active{background:#a77b48;color:#fff;border-color:#a77b48}.photos{display:flex;flex-wrap:wrap;margin-top:15rpx;gap:15rpx}.photo{position:relative}.photo image,.add{width:200rpx;height:200rpx;border-radius:10rpx}.add{margin:0;background:#fff;border:1rpx dashed #b9a996;color:#8a6b4a;font-size:24rpx}.cover,.remove{position:absolute;color:#fff;background:#a77b48;padding:5rpx 10rpx;font-size:20rpx}.cover{left:0;bottom:0}.remove{right:0;top:0;background:#9f453d}.save{margin:55rpx 0 25rpx}
