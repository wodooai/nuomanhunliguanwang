<view class="page"><view class="head"><view><view class="title">案例管理</view><view class="muted">{{list.length}} 个已发布案例</view></view><text class="danger" bindtap="logout">退出</text></view><button class="button" bindtap="add">＋ 新增案例</button><view class="card" wx:for="{{list}}" wx:key="id"><image mode="aspectFill" src="{{item.cover}}"/><view class="content"><view>{{item.title}}</view><text class="muted">{{item.category}} · {{item.date}}</text><view><text class="edit" data-id="{{item.id}}" bindtap="edit">编辑</text><text class="danger" data-id="{{item.id}}" bindtap="del">删除</text></view></view></view></view>
